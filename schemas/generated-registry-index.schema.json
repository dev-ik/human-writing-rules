{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/generated-registry-index.schema.json",
  "title": "Human Writing Rules generated registry index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "spec_revision",
    "source_revision",
    "source_files",
    "counts",
    "defaults",
    "objects",
    "values",
    "rfcs"
  ],
  "properties": {
    "$schema": {
      "const": "https://human-writing-rules.example/schemas/generated-registry-index.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "source_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "defaults": {
      "type": "object"
    },
    "objects": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/object"
      }
    },
    "values": {
      "type": "object",
      "required": [
        "languages",
        "formats",
        "topics",
        "platforms",
        "skills",
        "tones"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object"
        }
      }
    },
    "rfcs": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "title",
        "status",
        "path",
        "requires"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
