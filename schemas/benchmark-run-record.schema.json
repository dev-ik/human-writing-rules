{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/benchmark-run-record.schema.json",
  "title": "Human Writing Rules benchmark execution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "benchmark_run_id",
    "status",
    "case",
    "plan",
    "spec_revision",
    "registry_revision",
    "run_date",
    "execution_order",
    "controls",
    "treatment_difference",
    "workspace",
    "attempts",
    "counts",
    "evaluation",
    "known_limitations",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "https://human-writing-rules.example/schemas/benchmark-run-record.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "complete",
        "complete-with-failures"
      ]
    },
    "case": {
      "type": "object"
    },
    "plan": {
      "type": "object"
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "registry_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "run_date": {
      "type": "string",
      "minLength": 1
    },
    "execution_order": {
      "const": "declared-arm-order"
    },
    "controls": {
      "type": "object"
    },
    "treatment_difference": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "counts": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array"
    }
  }
}
