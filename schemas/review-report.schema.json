{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/review-report.schema.json",
  "title": "Human Writing Rules review adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "artifact_revision",
    "review_revision",
    "reviewers",
    "findings",
    "limitations",
    "readiness_candidate",
    "adapter"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_revision": {
      "type": "string",
      "minLength": 1
    },
    "review_revision": {
      "type": "string",
      "minLength": 1
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "status"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "object_revision": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "input-error"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readiness_candidate": {
      "enum": [
        "publication-ready",
        "ready-with-minor-findings",
        "not-ready",
        "input-failure"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reviewer",
        "severity",
        "location",
        "summary",
        "reason",
        "rule",
        "claim_ids",
        "correction",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "note"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "correction": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "fixed",
            "withdrawn",
            "deferred",
            "accepted-risk"
          ]
        }
      }
    }
  }
}
