{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/workflow-record.schema.json",
  "title": "Human Writing Rules persisted editorial workflow record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "status",
    "state",
    "workspace",
    "current_run_file",
    "stages",
    "output_files",
    "warnings"
  ],
  "properties": {
    "$schema": {
      "const": "https://human-writing-rules.example/schemas/workflow-record.schema.json"
    },
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "running",
        "blocked",
        "needs-revision",
        "failed",
        "complete"
      ]
    },
    "state": {
      "enum": [
        "blocked",
        "context-ready",
        "media-decided",
        "drafted",
        "edited",
        "reviewed",
        "revising",
        "ready"
      ]
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "current_run_file": {
      "type": "string",
      "minLength": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "input_state",
          "output_state",
          "run_file"
        ],
        "properties": {
          "stage": {
            "enum": [
              "plan",
              "design",
              "draft",
              "edit",
              "visual",
              "review",
              "revision",
              "finalize"
            ]
          },
          "input_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "output_state": {
            "type": "string",
            "minLength": 1
          },
          "run_file": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "output_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array"
    },
    "blockers": {
      "type": "array"
    },
    "open_findings": {
      "type": "array"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "array"
        }
      }
    }
  }
}
