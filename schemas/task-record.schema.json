{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/task-record.schema.json",
  "title": "Human Writing Rules task record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "enum": [
        "article",
        "social-post"
      ]
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "author_perspective": {
      "enum": [
        "editorial",
        "first-person",
        "expert",
        "reporter",
        "neutral"
      ]
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "audience": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "minProperties": 1
        }
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "central_question": {
      "type": "string",
      "minLength": 1
    },
    "reader_promise": {
      "type": "string",
      "minLength": 1
    },
    "primary_job": {
      "type": "string",
      "minLength": 1
    },
    "artifact_form": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_disclosures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visuals": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "auto",
            "required"
          ]
        }
      }
    },
    "assessments": {
      "$ref": "#/$defs/assessments"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "media": {
      "$ref": "#/$defs/media"
    }
  },
  "$defs": {
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_freshness": {
          "enum": [
            "adequate",
            "inadequate",
            "unknown",
            "not-applicable"
          ]
        },
        "platform_constraints": {
          "enum": [
            "known",
            "unknown",
            "not-applicable"
          ]
        },
        "perspective": {
          "enum": [
            "authorized",
            "unauthorized",
            "unknown",
            "not-applicable"
          ]
        },
        "rights": {
          "enum": [
            "cleared",
            "blocked",
            "unknown",
            "not-applicable"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "publication_date": {
          "type": "string",
          "minLength": 1
        },
        "retrieved_at": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "$ref": "source-snapshot.schema.json"
        }
      },
      "not": {
        "required": [
          "snapshot_path",
          "snapshot"
        ]
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "classification",
        "material",
        "source_ids",
        "disposition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "verified-fact",
            "source-claim",
            "opinion",
            "inference",
            "assumption",
            "unknown"
          ]
        },
        "material": {
          "type": "boolean"
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "use",
            "narrow",
            "attribute",
            "research",
            "omit"
          ]
        }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "pending",
            "none",
            "selected",
            "blocked"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "brief": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "reader_benefit": {
              "type": "string",
              "minLength": 1
            },
            "evidence_basis": {
              "type": "string",
              "minLength": 1
            },
            "must_not_imply": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            },
            "asset_type": {
              "type": "string",
              "minLength": 1
            },
            "acceptance_criteria": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
