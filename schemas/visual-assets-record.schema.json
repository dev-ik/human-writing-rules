{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/visual-assets-record.schema.json",
  "title": "Human Writing Rules visual production adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "artifact_revision",
    "visual_revision",
    "items",
    "adapter"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_revision": {
      "type": "string",
      "minLength": 1
    },
    "visual_revision": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "asset",
          "purpose",
          "caption",
          "alt_text",
          "provenance"
        ],
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "alt_text": {
            "type": "string",
            "minLength": 1
          },
          "provenance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "human",
            "model",
            "tool"
          ]
        }
      }
    }
  }
}
