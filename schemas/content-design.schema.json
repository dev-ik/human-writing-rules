{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/content-design.schema.json",
  "title": "Human Writing Rules content-design adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "design_revision",
    "reader_promise",
    "working_thesis",
    "sections_or_units",
    "public_metadata"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "design_revision": {
      "type": "string",
      "minLength": 1
    },
    "reader_promise": {
      "type": "string",
      "minLength": 1
    },
    "working_thesis": {
      "type": "string",
      "minLength": 1
    },
    "sections_or_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "claim_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "public_metadata": {
      "type": "object"
    },
    "visual_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "human",
            "model",
            "tool"
          ]
        }
      }
    }
  }
}
