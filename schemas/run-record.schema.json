{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/run-record.schema.json",
  "title": "Human Writing Rules reference run record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "task_id",
    "task_revision",
    "spec_revision",
    "registry_revision",
    "state",
    "blocked_stage",
    "task",
    "resolution",
    "sources",
    "claim_ledger",
    "gates",
    "content_design",
    "review_plan",
    "output_package",
    "blockers",
    "next_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_revision": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "registry_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "blocked",
        "context-ready",
        "media-decided",
        "drafted",
        "edited",
        "reviewed",
        "revising",
        "ready"
      ]
    },
    "blocked_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "task": {
      "type": "object"
    },
    "resolution": {
      "$ref": "#/$defs/resolution"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claim_ledger": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gates": {
      "type": "object"
    },
    "content_design": {
      "type": "object"
    },
    "review_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer_id",
          "title",
          "status"
        ]
      }
    },
    "output_package": {
      "type": "object"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "resolution": {
      "type": "object",
      "required": [
        "spec_revision",
        "registry_revision",
        "inputs",
        "origins",
        "root_objects",
        "dependency_order",
        "fallbacks",
        "inferences",
        "conflicts",
        "warnings"
      ],
      "properties": {
        "spec_revision": {
          "type": "string"
        },
        "registry_revision": {
          "type": "string"
        },
        "inputs": {
          "type": "object"
        },
        "origins": {
          "type": "object"
        },
        "root_objects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dependency_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fallbacks": {
          "type": "array"
        },
        "inferences": {
          "type": "array"
        },
        "conflicts": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      }
    }
  }
}
