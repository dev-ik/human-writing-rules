{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/conformance-fixture.schema.json",
  "title": "Human Writing Rules conformance fixture suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "spec_revision",
    "target",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "const": "conformance-requirements"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "mutation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "old",
            "new"
          ],
          "properties": {
            "type": {
              "const": "text-replace"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "old": {
              "type": "string",
              "minLength": 1
            },
            "new": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text-append"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "requirement_id",
            "field",
            "value"
          ],
          "properties": {
            "type": {
              "const": "requirement-set"
            },
            "requirement_id": {
              "type": "string",
              "pattern": "^HWR-(SCOPE|PIPE|OBJ|RESOLVE|REVIEW|BENCH)-[0-9]{3}$"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field",
            "value"
          ],
          "properties": {
            "type": {
              "const": "manifest-set"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "requirement_id",
            "removed_in",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "reuse-retired-id"
            },
            "requirement_id": {
              "type": "string",
              "pattern": "^HWR-(SCOPE|PIPE|OBJ|RESOLVE|REVIEW|BENCH)-[0-9]{3}$"
            },
            "removed_in": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "mutations",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONF-[A-Z0-9-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "related_requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^HWR-(SCOPE|PIPE|OBJ|RESOLVE|REVIEW|BENCH)-[0-9]{3}$"
          }
        },
        "mutations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mutation"
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid",
            "error_contains"
          ],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "error_contains": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
