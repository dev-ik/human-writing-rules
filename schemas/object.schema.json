{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Writing Rules Object",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "status",
    "path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "core",
        "principle",
        "rule",
        "language",
        "format",
        "topic",
        "platform",
        "tone",
        "skill",
        "reviewer",
        "benchmark",
        "example",
        "rfc"
      ]
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "path": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
