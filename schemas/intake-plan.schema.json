{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://human-writing-rules.example/schemas/intake-plan.schema.json",
  "title": "Human Writing Rules agent-led intake plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "spec_revision",
    "registry_revision",
    "status",
    "question_batch",
    "questions_total",
    "remaining_question_count",
    "agent_actions",
    "proposed_defaults",
    "instructions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_revision": {
      "type": "string",
      "minLength": 1
    },
    "registry_revision": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "questions-required",
        "agent-action-required",
        "ready"
      ]
    },
    "question_batch": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "questions_total": {
      "type": "integer",
      "minimum": 0
    },
    "remaining_question_count": {
      "type": "integer",
      "minimum": 0
    },
    "agent_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "proposed_defaults": {
      "type": "object"
    },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "prompt",
        "why",
        "required",
        "blocks_drafting",
        "answer_format",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "const": true
        },
        "blocks_drafting": {
          "const": true
        },
        "answer_format": {
          "enum": [
            "free-text",
            "confirm-or-correct",
            "choice-and-free-text"
          ]
        },
        "options": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field",
        "action",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
